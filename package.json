{
  "name": "nhacmix-player",
  "version": "1.5.0",
  "private": true,
  "description": "NhacMix player with local media playlists, website links and native Android media controls",
  "scripts": {
    "start": "npm run build:bridge && npx serve www",
    "android:sync": "npm run build:bridge && cap sync android",
    "patch:android-media": "python3 scripts/patch-android-media.py",
    "build:bridge": "esbuild scripts/native-bridge.js --bundle --format=iife --platform=browser --target=es2020 --outfile=www/cap-bridge.bundle.js",
    "build": "npm run build:bridge"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/browser": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "serve": "^14.2.4",
    "esbuild": "^0.24.2"
  }
}
